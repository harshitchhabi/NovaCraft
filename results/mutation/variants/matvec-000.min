// mutation matvec-000: start-minus-one at 3:10 (i = 0 to i = -1)
func matvec(a: int[], alen: int, x: int[], xlen: int, out: int[], outlen: int, rows: int, cols: int) -> int {
    for (let i: int = (-1); (i < rows); i = (i + 1)) {
        let s: int = 0;
        for (let j: int = 0; (j < cols); j = (j + 1)) {
            s = (s + (a[((i * cols) + j)] * x[j]));
        }
        out[i] = s;
    }
    return out[0];
}

func main() -> int {
    return 0;
}
