// mutation gather-015: swap-index-var at 4:13 (i to ilen in out[...])
func gather(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < ilen); i = (i + 1)) {
        out[ilen] = a[idx[i]];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
