// mutation sumArray-002: bound-plus-one at 5:16 (len to len + 1)
func sumArray(arr: int[], len: int) -> int {
    let total: int = 0;
    let i: int = 0;
    while ((i < (len + 1))) {
        total = (total + arr[i]);
        i = (i + 1);
    }
    return total;
}

func main() -> int {
    return 0;
