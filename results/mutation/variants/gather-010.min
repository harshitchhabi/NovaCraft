// mutation gather-010: swap-index-var at 4:24 (i to ilen in idx[...])
func gather(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < ilen); i = (i + 1)) {
        out[i] = a[idx[ilen]];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
