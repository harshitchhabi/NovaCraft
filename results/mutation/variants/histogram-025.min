// mutation histogram-025: index-is-length at 7:12 (hist[e] to hist[hlen])
func histogram(data: int[], dlen: int, hist: int[], hlen: int) -> int {
    for (let i: int = 0; (i < dlen); i = (i + 1)) {
        let b: int = data[i];
        hist[b] = (hist[b] + 1);
    }
    return hist[hlen];
}

func main() -> int {
    return 0;
}
