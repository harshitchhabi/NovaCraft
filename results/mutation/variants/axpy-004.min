// mutation axpy-004: swap-index-var at 4:26 (i to xlen in x[...])
func axpy(x: int[], xlen: int, y: int[], ylen: int, alpha: int, n: int) -> int {
    for (let i: int = 0; (i < n); i = (i + 1)) {
        y[i] = ((alpha * x[xlen]) + y[i]);
    }
    return y[0];
}

func main() -> int {
    return 0;
}
