// mutation stencil-005: swap-index-var at 7:22 (i to slen in src[...])
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while ((i < (slen - 1))) {
        dst[i] = ((src[(slen - 1)] + src[i]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
