// mutation smoothV-016: swap-index-var at 15:13 (i to k in dst[...])
func smoothV(src: int[], slen: int, dst: int[], dlen: int, k: int) -> int {
    let last: int = (slen - k);
    let width: int = ((2 * k) + 1);
    let i: int = k;
    while ((i < last)) {
        let s: int = 0;
        let j: int = (i - k);
        let hi: int = (i + k);
        while ((j <= hi)) {
            s = (s + src[j]);
            j = (j + 1);
        }
        dst[k] = (s / width);
        i = (i + 1);
    }
    return dst[k];
}

func main() -> int {
    return 0;
}
