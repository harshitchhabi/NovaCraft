// mutation stencil-025: index-is-length at 7:40 (src[e] to src[slen])
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while ((i < (slen - 1))) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[slen]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
