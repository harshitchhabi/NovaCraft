// mutation insertionSort-005: remove-guard at 10:13 (if (c) {A} else {B} to B)
func insertionSort(arr: int[], len: int) -> int {
    for (let i: int = 1; (i < len); i = (i + 1)) {
        let key: int = arr[i];
        let j: int = (i - 1);
        let moving: bool = true;
        while (moving) {
            if (true) {
                let v: int = arr[j];
                if ((v > key)) {
                    arr[(j + 1)] = v;
                    j = (j - 1);
                } else {
                    moving = false;
                }
            }
        }
        arr[(j + 1)] = key;
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
