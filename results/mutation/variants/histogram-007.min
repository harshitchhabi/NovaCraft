// mutation histogram-007: swap-index-var at 4:27 (i to hlen in data[...])
func histogram(data: int[], dlen: int, hist: int[], hlen: int) -> int {
    for (let i: int = 0; (i < dlen); i = (i + 1)) {
        let b: int = data[hlen];
        hist[b] = (hist[b] + 1);
    }
    return hist[0];
}

func main() -> int {
    return 0;
}
