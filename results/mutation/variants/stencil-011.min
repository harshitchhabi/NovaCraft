// mutation stencil-011: index-plus-one at 7:40 (src[e] to src[e + 1])
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while ((i < (slen - 1))) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[((i + 1) + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
