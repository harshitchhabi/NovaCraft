// mutation reverse-018: swap-index-var at 7:13 (i to t in arr[...])
func reverse(arr: int[], len: int) -> int {
    let half: int = (len / 2);
    for (let i: int = 0; (i < half); i = (i + 1)) {
        let j: int = ((len - 1) - i);
        let t: int = arr[i];
        arr[t] = arr[j];
        arr[j] = t;
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
