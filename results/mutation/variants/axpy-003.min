// mutation axpy-003: index-minus-one at 4:24 (x[e] to x[e - 1])
func axpy(x: int[], xlen: int, y: int[], ylen: int, alpha: int, n: int) -> int {
    for (let i: int = 0; (i < n); i = (i + 1)) {
        y[i] = ((alpha * x[(i - 1)]) + y[i]);
    }
    return y[0];
}

func main() -> int {
    return 0;
}
