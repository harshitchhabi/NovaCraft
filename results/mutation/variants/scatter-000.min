// mutation scatter-000: start-minus-one at 3:10 (i = 0 to i = -1)
func scatter(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = (-1); (i < alen); i = (i + 1)) {
        out[idx[i]] = a[i];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
