// mutation bubbleSort-028: swap-index-var at 9:21 (j to y in arr[...])
func bubbleSort(arr: int[], len: int) -> int {
    for (let i: int = 0; (i < (len - 1)); i = (i + 1)) {
        for (let j: int = 0; (j < ((len - 1) - i)); j = (j + 1)) {
            let x: int = arr[j];
            let y: int = arr[(j + 1)];
            if ((x > y)) {
                arr[j] = y;
                arr[(y + 1)] = x;
            }
        }
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
