// mutation gather-012: index-plus-one at 4:9 (out[e] to out[e + 1])
func gather(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < ilen); i = (i + 1)) {
        out[(i + 1)] = a[idx[i]];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
