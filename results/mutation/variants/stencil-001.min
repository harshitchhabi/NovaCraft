// mutation stencil-001: bound-plus-one at 6:16 (slen to slen + 1)
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while ((i < ((slen + 1) - 1))) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
