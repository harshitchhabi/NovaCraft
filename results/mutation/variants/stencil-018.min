// mutation stencil-018: swap-index-var at 7:13 (i to dlen in dst[...])
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while ((i < (slen - 1))) {
        dst[dlen] = ((src[(i - 1)] + src[i]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
