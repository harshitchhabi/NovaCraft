// mutation reverse-007: index-plus-one at 7:18 (arr[e] to arr[e + 1])
func reverse(arr: int[], len: int) -> int {
    let half: int = (len / 2);
    for (let i: int = 0; (i < half); i = (i + 1)) {
        let j: int = ((len - 1) - i);
        let t: int = arr[i];
        arr[i] = arr[(j + 1)];
        arr[j] = t;
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
