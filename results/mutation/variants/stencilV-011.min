// mutation stencilV-011: swap-index-var at 7:35 (i to last in src[...])
func stencilV(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let last: int = (slen - 1);
    let i: int = 1;
    while ((i < last)) {
        dst[i] = ((src[(i - 1)] + src[last]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
