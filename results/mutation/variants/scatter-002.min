// mutation scatter-002: bound-plus-one at 3:30 (alen to alen + 1)
func scatter(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < (alen + 1)); i = (i + 1)) {
        out[idx[i]] = a[i];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
