// mutation bubbleSort-015: remove-guard at 7:13 (if (c) {A} to A)
func bubbleSort(arr: int[], len: int) -> int {
    for (let i: int = 0; (i < (len - 1)); i = (i + 1)) {
        for (let j: int = 0; (j < ((len - 1) - i)); j = (j + 1)) {
            let x: int = arr[j];
            let y: int = arr[(j + 1)];
            if (true) {
                arr[j] = y;
                arr[(j + 1)] = x;
            }
        }
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
