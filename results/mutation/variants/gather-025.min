// mutation gather-025: index-is-length at 6:12 (out[e] to out[olen])
func gather(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < ilen); i = (i + 1)) {
        out[i] = a[idx[i]];
    }
    return out[olen];
}

func main() -> int {
    return 0;
}
