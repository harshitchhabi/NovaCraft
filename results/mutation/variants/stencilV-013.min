// mutation stencilV-013: index-minus-one at 7:40 (src[e] to src[e - 1])
func stencilV(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let last: int = (slen - 1);
    let i: int = 1;
    while ((i < last)) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[((i + 1) - 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
