// mutation matvec-002: start-minus-one at 5:14 (j = 0 to j = -1)
func matvec(a: int[], alen: int, x: int[], xlen: int, out: int[], outlen: int, rows: int, cols: int) -> int {
    for (let i: int = 0; (i < rows); i = (i + 1)) {
        let s: int = 0;
        for (let j: int = (-1); (j < cols); j = (j + 1)) {
            s = (s + (a[((i * cols) + j)] * x[j]));
        }
        out[i] = s;
    }
    return out[0];
}

func main() -> int {
    return 0;
}
