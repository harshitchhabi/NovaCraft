// mutation scatter-020: index-plus-one at 6:12 (out[e] to out[e + 1])
func scatter(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < alen); i = (i + 1)) {
        out[idx[i]] = a[i];
    }
    return out[(0 + 1)];
}

func main() -> int {
    return 0;
}
