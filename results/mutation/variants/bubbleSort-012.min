// mutation bubbleSort-012: swap-index-var at 6:30 (j to len in arr[...])
func bubbleSort(arr: int[], len: int) -> int {
    for (let i: int = 0; (i < (len - 1)); i = (i + 1)) {
        for (let j: int = 0; (j < ((len - 1) - i)); j = (j + 1)) {
            let x: int = arr[j];
            let y: int = arr[(len + 1)];
            if ((x > y)) {
                arr[j] = y;
                arr[(j + 1)] = x;
            }
        }
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
