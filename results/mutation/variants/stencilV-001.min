// mutation stencilV-001: lt-to-le at 6:14 (< to <=)
func stencilV(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let last: int = (slen - 1);
    let i: int = 1;
    while ((i <= last)) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
