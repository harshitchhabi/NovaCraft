// mutation histogram-008: index-plus-one at 5:19 (hist[e] to hist[e + 1])
func histogram(data: int[], dlen: int, hist: int[], hlen: int) -> int {
    for (let i: int = 0; (i < dlen); i = (i + 1)) {
        let b: int = data[i];
        hist[b] = (hist[(b + 1)] + 1);
    }
    return hist[0];
}

func main() -> int {
    return 0;
}
