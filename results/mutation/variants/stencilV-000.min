// mutation stencilV-000: swap-length at 4:21 (slen to dlen)
func stencilV(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let last: int = (dlen - 1);
    let i: int = 1;
    while ((i < last)) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
