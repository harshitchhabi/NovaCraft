// mutation bubbleSort-017: index-minus-one at 8:17 (arr[e] to arr[e - 1])
func bubbleSort(arr: int[], len: int) -> int {
    for (let i: int = 0; (i < (len - 1)); i = (i + 1)) {
        for (let j: int = 0; (j < ((len - 1) - i)); j = (j + 1)) {
            let x: int = arr[j];
            let y: int = arr[(j + 1)];
            if ((x > y)) {
                arr[(j - 1)] = y;
                arr[(j + 1)] = x;
            }
        }
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
