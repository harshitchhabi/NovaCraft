// mutation axpy-015: index-minus-one at 4:9 (y[e] to y[e - 1])
func axpy(x: int[], xlen: int, y: int[], ylen: int, alpha: int, n: int) -> int {
    for (let i: int = 0; (i < n); i = (i + 1)) {
        y[(i - 1)] = ((alpha * x[i]) + y[i]);
    }
    return y[0];
}

func main() -> int {
    return 0;
}
