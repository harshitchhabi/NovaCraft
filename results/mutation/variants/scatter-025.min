// mutation scatter-025: index-is-length at 6:12 (out[e] to out[olen])
func scatter(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < alen); i = (i + 1)) {
        out[idx[i]] = a[i];
    }
    return out[olen];
}

func main() -> int {
    return 0;
}
