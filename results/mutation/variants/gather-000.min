// mutation gather-000: start-minus-one at 3:10 (i = 0 to i = -1)
func gather(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = (-1); (i < ilen); i = (i + 1)) {
        out[i] = a[idx[i]];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
