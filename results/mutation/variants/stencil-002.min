// mutation stencil-002: swap-length at 6:16 (slen to dlen)
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while ((i < (dlen - 1))) {
        dst[i] = ((src[(i - 1)] + src[i]) + src[(i + 1)]);
        i = (i + 1);
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
