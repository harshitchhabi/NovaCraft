// mutation sumArray-004: index-minus-one at 6:25 (arr[e] to arr[e - 1])
func sumArray(arr: int[], len: int) -> int {
    let total: int = 0;
    let i: int = 0;
    while ((i < len)) {
        total = (total + arr[(i - 1)]);
        i = (i + 1);
    }
    return total;
}

func main() -> int {
    return 0;
