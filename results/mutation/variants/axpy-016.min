// mutation axpy-016: swap-index-var at 4:11 (i to xlen in y[...])
func axpy(x: int[], xlen: int, y: int[], ylen: int, alpha: int, n: int) -> int {
    for (let i: int = 0; (i < n); i = (i + 1)) {
        y[xlen] = ((alpha * x[i]) + y[i]);
    }
    return y[0];
}

func main() -> int {
    return 0;
}
