// mutation histogram-005: index-minus-one at 4:22 (data[e] to data[e - 1])
func histogram(data: int[], dlen: int, hist: int[], hlen: int) -> int {
    for (let i: int = 0; (i < dlen); i = (i + 1)) {
        let b: int = data[(i - 1)];
        hist[b] = (hist[b] + 1);
    }
    return hist[0];
}

func main() -> int {
    return 0;
}
