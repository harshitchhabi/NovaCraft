// mutation scatter-013: write-index-external at 4:9 (out[e] = ... to out[ilen] = ...)
func scatter(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < alen); i = (i + 1)) {
        out[ilen] = a[i];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
