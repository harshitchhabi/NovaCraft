// mutation gather-002: bound-plus-one at 3:30 (ilen to ilen + 1)
func gather(a: int[], alen: int, idx: int[], ilen: int, out: int[], olen: int) -> int {
    for (let i: int = 0; (i < (ilen + 1)); i = (i + 1)) {
        out[i] = a[idx[i]];
    }
    return out[0];
}

func main() -> int {
    return 0;
}
