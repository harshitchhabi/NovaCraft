// mutation smoothV-002: index-plus-one at 12:21 (src[e] to src[e + 1])
func smoothV(src: int[], slen: int, dst: int[], dlen: int, k: int) -> int {
    let last: int = (slen - k);
    let width: int = ((2 * k) + 1);
    let i: int = k;
    while ((i < last)) {
        let s: int = 0;
        let j: int = (i - k);
        let hi: int = (i + k);
        while ((j <= hi)) {
            s = (s + src[(j + 1)]);
            j = (j + 1);
        }
        dst[i] = (s / width);
        i = (i + 1);
    }
    return dst[k];
}

func main() -> int {
    return 0;
}
