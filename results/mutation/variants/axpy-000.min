// mutation axpy-000: start-minus-one at 3:10 (i = 0 to i = -1)
func axpy(x: int[], xlen: int, y: int[], ylen: int, alpha: int, n: int) -> int {
    for (let i: int = (-1); (i < n); i = (i + 1)) {
        y[i] = ((alpha * x[i]) + y[i]);
    }
    return y[0];
}

func main() -> int {
    return 0;
}
