// mutation bubbleSort-033: index-is-length at 6:26 (arr[e] to arr[len])
func bubbleSort(arr: int[], len: int) -> int {
    for (let i: int = 0; (i < (len - 1)); i = (i + 1)) {
        for (let j: int = 0; (j < ((len - 1) - i)); j = (j + 1)) {
            let x: int = arr[j];
            let y: int = arr[len];
            if ((x > y)) {
                arr[j] = y;
                arr[(j + 1)] = x;
            }
        }
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
