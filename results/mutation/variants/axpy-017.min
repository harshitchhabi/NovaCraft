// mutation axpy-017: swap-index-var at 4:11 (i to ylen in y[...])
func axpy(x: int[], xlen: int, y: int[], ylen: int, alpha: int, n: int) -> int {
    for (let i: int = 0; (i < n); i = (i + 1)) {
        y[ylen] = ((alpha * x[i]) + y[i]);
    }
    return y[0];
}

func main() -> int {
    return 0;
}
