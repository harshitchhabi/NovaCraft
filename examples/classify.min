// Exercises `else if` chaining (parser-level sugar over nested if/else --
// see src/parser.ts, parseIfStmt) where every branch of the whole chain
// returns and the chain is itself the function's last statement. This is a
// regression example for a codegen bug where a bare `if` (no declared WASM
// result type) as a function's terminal statement, with both branches
// returning, failed WASM validation even though every path is guaranteed to
// return -- see the trailing `unreachable` emitted in src/codegen.ts.
func classify(x: int) -> int {
    if (x < 0) {
        return 0;
    } else if (x == 0) {
        return 1;
    } else if (x < 10) {
        return 2;
    } else {
        return 3;
    }
}

func main() -> int {
    print(classify(-5));
    print(classify(0));
    print(classify(5));
    print(classify(50));
    return 0;
}
