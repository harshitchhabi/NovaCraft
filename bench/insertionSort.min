// Insertion sort, in place. NovaCraft's && evaluates both operands (no
// short-circuit), so `j >= 0 && arr[j] > key` would read arr[-1]; the
// inner loop uses an explicit flag instead.
func insertionSort(arr: int[], len: int) -> int {
    for (let i: int = 1; i < len; i = i + 1) {
        let key: int = arr[i];
        let j: int = i - 1;
        let moving: bool = true;
        while (moving) {
            if (j < 0) {
                moving = false;
            } else {
                let v: int = arr[j];
                if (v > key) {
                    arr[j + 1] = v;
                    j = j - 1;
                } else {
                    moving = false;
                }
            }
        }
        arr[j + 1] = key;
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
