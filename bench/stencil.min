// 3-point 1D stencil, natural form: the bound `len - 1` is computed in the
// loop condition. Not provable for unconstrained len (len - 1 may wrap) and
// not versionable (the bound is not a plain register).
func stencil(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let i: int = 1;
    while (i < slen - 1) {
        dst[i] = src[i - 1] + src[i] + src[i + 1];
        i = i + 1;
    }
    return dst[1];
}

func main() -> int {
    return 0;
}
