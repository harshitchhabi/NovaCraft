// out = A * x, A is rows x cols, flattened row-major (A[i*cols + j]).
func matvec(a: int[], alen: int, x: int[], xlen: int, out: int[], outlen: int, rows: int, cols: int) -> int {
    for (let i: int = 0; i < rows; i = i + 1) {
        let s: int = 0;
        for (let j: int = 0; j < cols; j = j + 1) {
            s = s + a[i * cols + j] * x[j];
        }
        out[i] = s;
    }
    return out[0];
}

func main() -> int {
    return 0;
}
