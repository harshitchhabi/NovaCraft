// BUG: stencil loop starts at 0, so src[i - 1] reads src[-1]
// (internal index, read).
func stencilBad(src: int[], slen: int, dst: int[], dlen: int) -> int {
    let last: int = slen - 1;
    for (let i: int = 0; i < last; i = i + 1) {
        dst[i] = src[i - 1] + src[i] + src[i + 1];
    }
    return 0;
}

func main() -> int {
    return 0;
}
