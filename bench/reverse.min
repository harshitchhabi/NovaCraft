// In-place reversal by swapping arr[i] and arr[len - 1 - i].
func reverse(arr: int[], len: int) -> int {
    let half: int = len / 2;
    for (let i: int = 0; i < half; i = i + 1) {
        let j: int = len - 1 - i;
        let t: int = arr[i];
        arr[i] = arr[j];
        arr[j] = t;
    }
    return arr[0];
}

func main() -> int {
    return 0;
}
