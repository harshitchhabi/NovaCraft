// Provenance fixtures (milestone A1).

// Internal counter over an external bound: arr[i] index is internal.
// Histogram: index read from external data, so external.
func histogram(data: int[], dlen: int, hist: int[], hlen: int) -> int {
    let i: int = 0;
    while (i < dlen) {
        let b: int = data[i];
        hist[b] = hist[b] + 1;
        i = i + 1;
    }
    return 0;
}

// Called only with an internal constant index: parameter k is internal.
func getInternal(arr: int[], len: int, k: int) -> int {
    return arr[k];
}

// Called with an external index: parameter k is external.
func getExternal(arr: int[], len: int, k: int) -> int {
    return arr[k];
}

// Returns an external value (its parameter is external via the call site).
func passThrough(x: int) -> int {
    return x + 1;
}

func driver(arr: int[], len: int, k: int) -> int {
    let a: int = getInternal(arr, len, 2);
    let b: int = getExternal(arr, len, k);
    let c: int = passThrough(k);
    let d: int = passThrough(0);
    return a + b + arr[c] + arr[d];
}

func main() -> int {
    return 0;
}
